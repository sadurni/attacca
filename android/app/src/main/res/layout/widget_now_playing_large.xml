<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing, two rows high: a large cover, then title, artist and the controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/widget_cover_background"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_previous"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/widget_play_background"
                android:contentDescription="@string/action_play"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_next"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
