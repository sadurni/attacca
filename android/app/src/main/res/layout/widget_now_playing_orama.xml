<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing as O'rama: a still of the track's landscape, the title on it, the controls below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scene_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="@drawable/widget_panel"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="330dp"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="330dp"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_next_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="330dp"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/widget_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_cover_background"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_note" />

        <!-- The time between the cover and the buttons, so the landscape keeps its height. -->
        <LinearLayout
            android:id="@+id/widget_time_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/widget_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#D9FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_previous"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="@string/action_play"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_next"
            android:src="@drawable/ic_widget_next" />

        <ImageButton
            android:id="@+id/widget_favorite"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_favorite"
            android:src="@drawable/ic_widget_heart" />
    </LinearLayout>
</FrameLayout>
